# Local development only. Copy this file to api/.env and replace every
# change-me-* value with a different local value. Never reuse production secrets.
DATABASE_URL=sqlite+aiosqlite:///./sukaseafood-review-dev.sqlite3
SESSION_COOKIE_NAME=sukaseafood_review_session
SESSION_HOURS=12
SESSION_SECRET=change-me-development-session-secret
CSRF_SECRET=change-me-development-csrf-secret
RECEIPT_SECRET=change-me-development-receipt-secret
APP_ENV=development
SECURE_COOKIE=false

# Optional outside production. In production, set this to the narrow CIDR(s)
# of the reverse proxy that is allowed to supply X-Forwarded-For.
TRUSTED_PROXY_CIDRS=
